#!/bin/sh
# Tells the moving wallpapers and btop whether KDE is in light or dark mode, and which accent colour to use.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/kdeglobals"
update() {
  bg=$(kreadconfig6 --file kdeglobals --group Colors:Window --key BackgroundNormal)
  l=$(printf '%s' "$bg" | awk -F, 'NF>=3{print (($1*299+$2*587+$3*114)/1000>128)?1:0}')
  [ -n "$l" ] || return 0
  b="${XDG_CONFIG_HOME:-$HOME/.config}/btop/btop.conf"; t=framework-dots; [ "$l" = 0 ] || t=framework-dots-light
  # btop picks this up the next time it starts; other btop themes are left alone
  if grep -qsE '^color_theme = "framework-dots(-light)?"$' "$b" && ! grep -qs "^color_theme = \"$t\"$" "$b"; then sed -i "s/^color_theme = .*/color_theme = \"$t\"/" "$b"; fi
  ac=$("$HOME/.local/bin/framework-dots-accent" colours 2>/dev/null) || ac=null
  new="window.__mode&&__mode($l);window.__accent&&__accent(${ac:-null})"
  for d in "$HOME/.local/share/Steam/steamapps/common/wallpaper_engine/projects/myprojects"/dot-matrix-blackhole \
           "$HOME/.local/share/Steam/steamapps/common/wallpaper_engine/projects/myprojects"/dot-matrix-swirl \
           "$HOME/FrameworkDots-Wallpapers/steamapps/common/wallpaper_engine/projects/myprojects"/dot-matrix-blackhole \
           "$HOME/FrameworkDots-Wallpapers/steamapps/common/wallpaper_engine/projects/myprojects"/dot-matrix-swirl; do
    [ -d "$d" ] || continue
    [ "$(cat "$d/mode.js" 2>/dev/null)" = "$new" ] && continue
    printf '%s\n' "$new" > "$d/.mode.tmp" && mv "$d/.mode.tmp" "$d/mode.js"
  done
}
# KDE writes its settings in several steps, so keep checking until the file has been quiet for 3 seconds
quiet=0; seen=
while [ "$quiet" -lt 3 ]; do
  update
  sleep 1
  now=$(stat -c '%i %y' "$conf" 2>/dev/null)
  if [ "$now" = "$seen" ]; then quiet=$((quiet + 1)); else quiet=0; seen=$now; fi
done
update
