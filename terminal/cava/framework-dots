; Framework Dots for cava.  Plain bars:  cava -p ~/.config/cava/framework-dots   Dots:  cava-dots
[general]
framerate = 60
bar_width = 2
bar_spacing = 1
[color]
gradient = 1
gradient_count = 3
gradient_color_1 = '#6a6a6a'
gradient_color_2 = '#f6f6f6'
gradient_color_3 = '#f3531a'
[smoothing]
noise_reduction = 77
