{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // In kitty, the fish function swaps this for framework-dots.png
  "logo": { "type": "file", "source": "~/.config/fastfetch/framework-dots.txt", "color": { "1": "38;2;243;83;26" }, "padding": { "top": 1, "left": 2, "right": 4 } },
  "display": {
    "separator": " ",
    "color": { "keys": "38;2;138;138;138", "output": "38;2;240;240;240" },
    "key": { "width": 11 },
    "percent": { "type": 3, "color": { "green": "38;2;240;240;240", "yellow": "38;2;240;240;240", "red": "38;2;237;70;70" } },
    "bar": { "width": 24, "char": { "elapsed": "●", "total": "●" }, "border": { "left": "", "right": "" }, "color": { "elapsed": "38;2;243;83;26", "total": "38;2;58;58;58" } }
  },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "1;38;2;243;83;26", "at": "38;2;90;90;90", "host": "1;38;2;240;240;240" } },
    "break",
    { "type": "host", "key": "machine", "format": "{name}" },
    { "type": "os", "key": "system", "format": "{pretty-name}" },
    { "type": "kernel", "key": "kernel", "format": "{release}" },
    { "type": "de", "key": "desktop", "format": "{pretty-name} {version}" },
    { "type": "cpu", "key": "cpu", "format": "{name}" },
    { "type": "gpu", "key": "gpu", "format": "{name}" },
    { "type": "packages", "key": "packages" },
    { "type": "uptime", "key": "uptime" },
    "break",
    { "type": "memory", "key": "memory", "format": "{percentage-bar}  {percentage}" },
    { "type": "disk", "key": "disk", "folders": "/", "format": "{size-percentage-bar}  {size-percentage}" },
    { "type": "battery", "key": "battery", "format": "{capacity-bar}  {capacity}" },
    "break"
  ]
}
