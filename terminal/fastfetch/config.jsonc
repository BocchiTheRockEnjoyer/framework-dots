{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "file", "source": "~/.config/fastfetch/framework-dots.txt", "color": { "1": "38;2;243;83;26" }, "padding": { "top": 2, "left": 2, "right": 4 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;154;154;154", "title": "38;2;243;83;26" },
    "key": { "width": 11 },
    "percent": { "type": 3, "color": { "green": "38;2;240;240;240", "yellow": "38;2;243;83;26", "red": "38;2;237;70;70" } },
    "bar": { "width": 14, "char": { "elapsed": "●", "total": "·" }, "border": { "left": "", "right": "" }, "color": { "elapsed": "38;2;243;83;26", "total": "38;2;90;90;90" } }
  },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "38;2;243;83;26", "at": "38;2;122;122;122", "host": "38;2;240;240;240" } },
    { "type": "custom", "format": "{#38;2;74;74;74}· · · · · · · · · · · · · · · ·" },
    { "type": "host", "key": "host", "format": "{name}" },
    { "type": "os", "key": "os", "format": "{pretty-name}" },
    { "type": "kernel", "key": "kernel", "format": "{release}" },
    { "type": "de", "key": "desktop" },
    { "type": "shell", "key": "shell" },
    { "type": "packages", "key": "packages" },
    { "type": "uptime", "key": "uptime" },
    { "type": "cpu", "key": "cpu", "format": "{name}" },
    { "type": "memory", "key": "memory", "percent": { "type": 2 }, "format": "{percentage-bar}  {used} / {total}" },
    { "type": "disk", "key": "disk", "folders": "/", "format": "{size-percentage-bar}  {size-used} / {size-total}" },
    { "type": "battery", "key": "battery", "format": "{capacity-bar}  {capacity}" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
