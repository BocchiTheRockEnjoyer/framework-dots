# Framework Dots: terminal colours plus the accent, so it follows light and dark mode
color-link default "default"
color-link comment "italic brightblack"
color-link identifier "default"
color-link identifier.class "white"
color-link identifier.var "default"
color-link constant "brightyellow"
color-link constant.number "brightyellow"
color-link constant.string "yellow"
color-link constant.specialChar "#f3531a"
color-link symbol "brightblack"
color-link symbol.tag "#f3531a"
color-link statement "bold #f3531a"
color-link preproc "#f3531a"
color-link type "white"
color-link special "#f3531a"
color-link underlined "underline default"
color-link error "bold red"
color-link todo "bold #f3531a"
color-link hlsearch "#141414,#f3531a"
color-link selection "#141414,#f3531a"
color-link statusline "#f3531a"
color-link tabbar "brightblack"
color-link indent-char "brightblack"
color-link line-number "brightblack"
color-link current-line-number "#f3531a"
color-link cursor-line "default"
color-link color-column "brightblack"
color-link gutter-error "red"
color-link gutter-warning "yellow"
color-link diff-added "green"
color-link diff-modified "#f3531a"
color-link diff-deleted "red"
color-link match-brace "#141414,#f3531a"
color-link message "default"
color-link error-message "red"
