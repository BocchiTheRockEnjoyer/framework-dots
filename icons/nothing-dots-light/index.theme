[Icon Theme]
Name=Nothing Dots Light
Comment=Dot-matrix tray icons over Breeze Dark
Inherits=breeze,hicolor
Example=battery-060
FollowsColorScheme=true
Directories=tray,settings,places,places@2x,folders,folders@2x,mimes,mimes@2x,mimesbig,mimesbig@2x,actions,traysmall,traysmall@2x

[tray]
Size=22
MinSize=8
MaxSize=256
Type=Scalable
Context=Status

[settings]
Size=22
MinSize=8
MaxSize=256
Type=Scalable
Context=Applications

[places]
Size=22
MinSize=8
MaxSize=24
Type=Scalable
Context=Places

[folders]
Size=64
MinSize=25
MaxSize=512
Type=Scalable
Context=Places

[places@2x]
Size=22
Scale=2
MinSize=8
MaxSize=24
Type=Scalable
Context=Places

[folders@2x]
Size=64
Scale=2
MinSize=25
MaxSize=512
Type=Scalable
Context=Places

[mimes]
Size=22
MinSize=8
MaxSize=24
Type=Scalable
Context=MimeTypes

[mimes@2x]
Size=22
Scale=2
MinSize=8
MaxSize=24
Type=Scalable
Context=MimeTypes

[mimesbig]
Size=64
MinSize=25
MaxSize=512
Type=Scalable
Context=MimeTypes

[mimesbig@2x]
Size=64
Scale=2
MinSize=25
MaxSize=512
Type=Scalable
Context=MimeTypes

[actions]
Size=22
MinSize=8
MaxSize=256
Type=Scalable
Context=Actions

[traysmall]
Size=22
MinSize=8
MaxSize=24
Type=Scalable
Context=Applications

[traysmall@2x]
Size=22
Scale=2
MinSize=8
MaxSize=24
Type=Scalable
Context=Applications
